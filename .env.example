# Vercel runtime: use Neon's pooled URL. Never commit real values.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.neon.tech/neondb?sslmode=require"
# For Prisma migrations, inject the direct non-pooler URL as DATABASE_URL in the
# migration job. Do not run migrations with the Vercel runtime environment.
# Use a unique random value of at least 32 characters locally and in each deployed environment.
JWT_SECRET="replace-with-a-long-random-secret"

# Bank-transfer instructions shown only on an authorized order confirmation page.
BANK_TRANSFER_RECIPIENT_NAME=""
BANK_TRANSFER_IBAN=""
BANK_TRANSFER_BIC=""

# Packeta PUDO Widget v6 account API key. Packeta requires this public widget
# key to apply allowed branches/Z-BOX settings. Never use an API Password here.
NEXT_PUBLIC_PACKETA_WIDGET_API_KEY=""

# Transactional email. No provider adapter is enabled until a provider and
# these server-side settings are intentionally configured.
EMAIL_FROM=""
ORDER_NOTIFICATION_EMAIL=""

# Comgate Merchant API REST v2. Merchant ID and secret are server-side only.
# Comgate defaults a missing `test` request field to a live payment, therefore
# card payments remain disabled unless every server-side guard is explicit.
COMGATE_MERCHANT_ID=""
COMGATE_SECRET=""
COMGATE_CARD_PAYMENTS_ENABLED="false"
# Exactly one explicit mode: "test" for Comgate test transactions, or "live".
# Leave empty to fail closed. The browser can never choose this mode.
COMGATE_TRANSACTION_MODE=""
# Required in Vercel Production together with the public notice for a temporary
# Comgate review using test transactions. It must be false for a live gateway.
COMGATE_TEST_MODE_REVIEW_ENABLED="false"
# Required for any live transaction in addition to COMGATE_TRANSACTION_MODE="live".
COMGATE_LIVE_MODE_ENABLED="false"
# UI-only flags. They do not enable server-side payment creation.
NEXT_PUBLIC_COMGATE_CARD_ENABLED="false"
NEXT_PUBLIC_COMGATE_TEST_MODE_NOTICE="false"
