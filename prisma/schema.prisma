generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  password  String?  // Ak by si neskôr robil vlastné prihlasovanie
  orders    Order[]
  createdAt DateTime @default(now())
}

// 1. HLAVNÁ KATEGÓRIA (napr. Čaje, Zdravé potraviny)
model Category {
  id            String        @id @default(uuid())
  name          String        @unique
  subcategories SubCategory[] // Prepojenie na podkategórie
}

// 2. PODKATEGÓRIA (napr. Zelené čaje, Čínske čaje)
model SubCategory {
  id         String    @id @default(uuid())
  name       String
  categoryId String
  category   Category  @relation(fields: [categoryId], references: [id])
  products   Product[] // Prepojenie na konkrétne produkty
}

// 3. PRODUKT (patrí do konkrétnej podkategórie)
model Product {
  id            String      @id @default(uuid())
  name          String
  description   String
  price         Decimal     @db.Decimal(10, 2)
  oldPrice      Decimal?    @db.Decimal(10, 2) // Zmenené na camelCase a pridaný ?, lebo nie každý produkt je v zľave
  stock         Int         @default(10)
  imageUrl      String?     // Pridaný ?, aby stránka nespadla, ak produkt zatiaľ nemá fotku
  subcategoryId String
  subcategory   SubCategory @relation(fields: [subcategoryId], references: [id])
  
  createdAt     DateTime    @default(now())
}

model Order {
  id         String   @id @default(uuid())
  userId     String?  // Voliteľné, aby si umožnil nákup aj "guest" užívateľom
  user       User?    @relation(fields: [userId], references: [id])
  totalPrice Decimal  @db.Decimal(10, 2)
  status     String   @default("PENDING") // PENDING, PAID, SHIPPED, COMPLETED
  createdAt  DateTime @default(now())
}

model DiscountCode {
  id            String   @id @default(uuid())
  code          String   @unique
  discountValue Decimal  @db.Decimal(10, 2)
  isActive      Boolean  @default(true)
}