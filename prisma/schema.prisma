generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  password      String?
// Vernosty program
  points        Int       @default(0) // Predvolene má nový zákazník 0 bodov
  
  // Fakturačné údaje
  company       String?
  phone         String?
  street        String?
  city          String?
  zip           String?

  // Prepojenie na doručovacie adresy (jeden používateľ môže mať viac adries)
  addresses     Address[]

  orders Order[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// Nová tabuľka pre doručovacie adresy
model Address {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  name      String  // Názov adresy (napr. "Domov" alebo "Jozef Mak")
  street    String
  city      String
  zip       String
  phone     String?
  isDefault Boolean @default(false)
}

// 1. HLAVNÁ KATEGÓRIA (napr. Čaje, Zdravé potraviny)
model Category {
  id            String        @id @default(uuid())
  name          String        @unique
  subcategories SubCategory[] // Prepojenie na podkategórie
}

// 2. PODKATEGÓRIA (napr. Zelené čaje, Čínske čaje)
model SubCategory {
  id         String    @id @default(uuid())
  name       String
  categoryId String
  category   Category  @relation(fields: [categoryId], references: [id])
  products   Product[] // Prepojenie na konkrétne produkty
}

// 3. PRODUKT (patrí do konkrétnej podkategórie)
model Product {
  id          String           @id @default(uuid())
  name        String
  description String?
  imageUrl    String?
  // Tvoje existujúce prepojenie na kategórie/podkategórie nechaj tak...
  subCategoryId String?
  subCategory   SubCategory?     @relation(fields: [subCategoryId], references: [id])
  
  // NOVÉ: Prepojenie na varianty
  variants    ProductVariant[]
}

model ProductVariant {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  weight    String  // napr. "50g", "100g", "500g", "1000g"
  price     Decimal // Cena pre túto konkrétnu gramáž
  oldPrice  Decimal? // Stará cena (ak je v zľave)
  stock     Int     @default(1) // 1 = Dostupný, 0 = Vypredaný
}

model Order {
  id                 String      @id @default(uuid())
  /// Public, non-sequential identifier safe for customer-facing URLs.
  orderNumber        String      @unique @default(cuid())
  userId             String?     // Voliteľné pre guest checkout
  user               User?       @relation(fields: [userId], references: [id])
  /// Retained for backwards compatibility with existing production orders.
  totalPrice         Decimal     @db.Decimal(10, 2)
  subtotal           Decimal     @default(0) @db.Decimal(12, 2)
  discount           Decimal     @default(0) @db.Decimal(12, 2)
  shippingPrice      Decimal     @default(0) @db.Decimal(12, 2)
  total              Decimal     @default(0) @db.Decimal(12, 2)
  currency           String      @default("EUR") @db.VarChar(3)
  status             String      @default("PENDING")
  paymentStatus      String      @default("PENDING")
  paymentMethod      String      @default("BANK_TRANSFER")
  paymentProvider    String?
  externalPaymentId  String?
  guestAccessToken   String?     @unique
  idempotencyKey     String      @unique
  requestFingerprint String
  discountCode       String?
  customerEmail      String?
  customerPhone      String?
  customerFirstName  String?
  customerLastName   String?
  shippingCountry    String?
  shippingStreet     String?
  shippingCity       String?
  shippingZip        String?
  shippingMethod     String?
  shippingMethodName String?
  pickupPointId      String?
  pickupPointData    Json?
  pickupPointCarrier String?
  pickupPointName    String?
  pickupPointAddress String?
  items              OrderItem[]
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  paidAt             DateTime?
  cancelledAt        DateTime?
}

model OrderItem {
  id            String   @id @default(cuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// Product/variant IDs are snapshots without FKs so historical orders survive catalogue deletion.
  productId     String
  variantId     String
  productName   String
  variantWeight String
  sku           String?
  quantity      Int
  unitPrice     Decimal  @db.Decimal(12, 2)
  totalPrice    Decimal  @db.Decimal(12, 2)

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

model DiscountCode {
  id                 String   @id @default(uuid())
  code               String   @unique
  /// Amount in EUR for FIXED_AMOUNT or percent value (e.g. 10.00 = 10%) for PERCENTAGE.
  discountValue      Decimal  @db.Decimal(10, 2)
  type               String   @default("FIXED_AMOUNT")
  isActive           Boolean  @default(true)
  validFrom          DateTime?
  validUntil         DateTime?
  minimumOrderAmount Decimal? @db.Decimal(12, 2)
  usageLimit         Int?
  usageCount         Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

/// Fixed-window counters shared by all Vercel instances. The subject is a one-way
/// SHA-256 hash, never raw IP, e-mail, session, or password data.
model RateLimitWindow {
  key         String   @id
  scope       String
  subjectHash String
  windowStart DateTime
  count       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([scope, subjectHash, windowStart])
}
