generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  password      String?
// Vernosty program
  points        Int       @default(0) // Predvolene má nový zákazník 0 bodov
  
  // Fakturačné údaje
  company       String?
  phone         String?
  street        String?
  city          String?
  zip           String?

  // Prepojenie na doručovacie adresy (jeden používateľ môže mať viac adries)
  addresses     Address[]

  orders Order[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// Nová tabuľka pre doručovacie adresy
model Address {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  name      String  // Názov adresy (napr. "Domov" alebo "Jozef Mak")
  street    String
  city      String
  zip       String
  phone     String?
  isDefault Boolean @default(false)
}

// 1. HLAVNÁ KATEGÓRIA (napr. Čaje, Zdravé potraviny)
model Category {
  id            String        @id @default(uuid())
  name          String        @unique
  subcategories SubCategory[] // Prepojenie na podkategórie
}

// 2. PODKATEGÓRIA (napr. Zelené čaje, Čínske čaje)
model SubCategory {
  id         String    @id @default(uuid())
  name       String
  categoryId String
  category   Category  @relation(fields: [categoryId], references: [id])
  products   Product[] // Prepojenie na konkrétne produkty
}

// 3. PRODUKT (patrí do konkrétnej podkategórie)
model Product {
  id          String           @id @default(uuid())
  name        String
  description String?
  imageUrl    String?
  // Tvoje existujúce prepojenie na kategórie/podkategórie nechaj tak...
  subCategoryId String?
  subCategory   SubCategory?     @relation(fields: [subCategoryId], references: [id])
  
  // NOVÉ: Prepojenie na varianty
  variants    ProductVariant[]
}

model ProductVariant {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  weight    String  // napr. "50g", "100g", "500g", "1000g"
  price     Decimal // Cena pre túto konkrétnu gramáž
  oldPrice  Decimal? // Stará cena (ak je v zľave)
  stock     Int     @default(1) // 1 = Dostupný, 0 = Vypredaný
}

model Order {
  id         String   @id @default(uuid())
  userId     String?  // Voliteľné, aby si umožnil nákup aj "guest" užívateľom
  user       User?    @relation(fields: [userId], references: [id])
  totalPrice Decimal  @db.Decimal(10, 2)
  status     String   @default("PENDING") // PENDING, PAID, SHIPPED, COMPLETED
  createdAt  DateTime @default(now())
}

model DiscountCode {
  id            String   @id @default(uuid())
  code          String   @unique
  discountValue Decimal  @db.Decimal(10, 2)
  isActive      Boolean  @default(true)
}